# Banco de dados Postgres (Supabase: Project Settings > Database > Connection string > "Transaction pooler", porta 6543).
# Formato: postgresql://postgres.<project_ref>:<SENHA>@<host-do-pooler>:6543/postgres
# Copie o host EXATO do botão "Connect" do painel (pode ser aws-0-... ou aws-1-...).
# Projeto atual: prqfoyhicnjduaplcymw (us-east-1)
# Sem esta variável, o app usa um banco embutido salvo em ./.data (só para uso no computador).
# Na Vercel, sem ela nada é salvo de verdade (banco temporário).
DATABASE_URL=

# Chave secreta das sessões de login. Gere uma com:  openssl rand -base64 32
# Obrigatória em produção (o app lança erro sem ela).
AUTH_SECRET=
